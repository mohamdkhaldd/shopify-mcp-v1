{
  "name": "mk-tech-rental",
  "version": "0.1.0",
  "private": true,
  "description": "MK-Tech: برنامج التأجير وبرنامج التشغيل لشركات المعدات",
  "author": "MK-Tech",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build && vite build -c vite.operations.config.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5174 && VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "rebuild:electron": "electron-rebuild -f -o better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p operations/tsconfig.json --noEmit",
    "build:tablet": "tsc -p tsconfig.json --noEmit && vite build --config vite.tablet.config.ts",
    "test:tablet": "TEST_DB=sqljs vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/device": "^7.0.5",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@electron/rebuild": "^3.6.2",
    "@fontsource/cairo": "^5.1.0",
    "@fontsource/noto-kufi-arabic": "^5.1.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.7",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.21.5",
    "exceljs": "^4.4.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "sql.js": "^1.15.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wait-on": "^8.0.1",
    "ws": "^8.22.0"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.albunyan.rental",
    "productName": "MK-Tech",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "mk-tech-rental-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MK-Tech"
    },
    "publish": {
      "provider": "github",
      "owner": "mohamdkhaldd",
      "repo": "albunyan-rental-releases",
      "releaseType": "release"
    }
  }
}
